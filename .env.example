# Cafoo runs fully in demo mode with this file copied to .env and every value left empty.
# Each key you fill switches that provider from its demo stand-in (noted per key below) to live calls.
# Quote every value. An unquoted # starts a comment and truncates the value.

# Claude Agent SDK (Advisor, Bookkeeper, Revenue, Credit & Risk). Empty = the scripted close over the real accounting
# engines (apps/agents/src/scripted), and the Advisor chat answers from the ledger tables
ANTHROPIC_API_KEY=""

# xAI Grok (Red Team). Empty = rule-based scripted critiques (apps/agents/src/redteam.ts)
XAI_API_KEY=""

# Bright Data MCP (live vendor lookups during close). Empty = fixtures/brightdata/*.md
API_TOKEN=""

# Apify (bulk crawl of customer sites into Moss; stretch). Empty = skipped
APIFY_TOKEN=""

# CRS Credit API sandbox (Credit & Risk cascade). Empty = CRS_REPLAY fixtures from the CSV
# Never retry a failed login: repeated failures disable the sandbox account permanently.
CRS_USERNAME=""
CRS_PASSWORD=""
CRS_BASE_URL="https://api-sandbox.stitchcredit.com/api"
CRS_REPLAY="1"

# Moss vector search. Empty = local in-memory keyword search over the same documents
MOSS_PROJECT_ID=""
MOSS_PROJECT_KEY=""

# SpacetimeDB (local by default; `spacetime start` listens on 3000)
SPACETIMEDB_URI="http://localhost:3000"
SPACETIMEDB_DB_NAME="cafoo"

# Agent gateway (OpenAI-compatible, for Open WebUI)
GATEWAY_PORT="8787"
# Address the gateway listens on. Empty: 127.0.0.1 (this machine only). "0.0.0.0" listens on every interface, for
# Open WebUI in Docker; set GATEWAY_API_KEY with it, or /v1/* refuses every other machine.
GATEWAY_HOST=""
# Browser origins allowed to call the gateway (comma-separated). Empty: the web app's localhost dev and preview origins.
GATEWAY_ALLOWED_ORIGINS=""
# Extra Host names the gateway answers to (comma-separated; "*" turns the check off). Empty: localhost, 127.0.0.1, [::1], host.docker.internal and the allowed origins' hosts.
GATEWAY_ALLOWED_HOSTS=""
# When set, /v1/* requires "Authorization: Bearer <key>". Give Open WebUI the same value as OPENAI_API_KEY.
# Empty: /v1/* answers only this machine.
GATEWAY_API_KEY=""

# Force the demo stand-ins even when keys are present
DEMO_MODE="1"

# Close month for seed data, YYYY-MM. Empty = last completed calendar month
CLOSE_PERIOD=""

# Live feed (runs in the gateway once the CFO switches it on and the close month is locked). Uncomment to change.
# Milliseconds between feed events (default 8000; 0 sends a month's events back to back)
# FEED_INTERVAL_MS="8000"
# Quiet time in milliseconds after the last new bank line before the Bookkeeper proposes (default 2000)
# FEED_DEBOUNCE_MS="2000"

# CFO seat: origin of the web app in the one-time claim link the seed loader prints (default http://localhost:5173),
# and how long a link armed by `pnpm cfo:bootstrap` stays valid in minutes (default 1440, at most 10080)
# PUBLIC_WEB_ORIGIN="http://localhost:5173"
# CFO_BOOTSTRAP_TTL_MINUTES="1440"

# Charter evals: the scratch database a full eval resets and closes (never the gateway's own; default cafoo-eval),
# and the database `pnpm -F @cafoo/agents smoke:charter` resets (default cafoo-charter-smoke)
# CHARTER_EVAL_DB="cafoo-eval"
# CHARTER_SMOKE_DB="cafoo-charter-smoke"
