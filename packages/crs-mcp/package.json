{
  "name": "@cafoo/crs-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "CRS Credit API sandbox client, response interpreters, credit cascade and an in-process MCP server for the Credit & Risk agent.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "check": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "fixtures:synth": "tsc -p tsconfig.build.json && node scripts/synthesize-fixtures.mjs",
    "fixtures:record": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env scripts/record-fixtures.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.309",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
